{
  "manifest_version": 3,
  "name": "Fedena Remarks Helper",
  "version": "1.3.0",
  "description": "Fill Fedena custom remarks and Gradebook marks from JSON. Never saves on its own.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.fedena.com/remarks/add_employee_custom_remarks*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.fedena.com/assessments/attribute_scores*"
      ],
      "js": [
        "marks.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "fedena-remarks-helper@local",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Fedena Remarks Helper",
    "default_popup": "popup.html"
  }
}